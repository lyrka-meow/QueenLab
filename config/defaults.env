# QueenLab defaults. Copy this file to ~/.config/queenlab/config.env to
# override values without changing the repository.

QL_CONNECT_URI="qemu:///system"
QL_STORAGE_DIR="/var/lib/libvirt/images/queenlab"
QL_BASE_DOMAIN="queenlab-base"
QL_BASE_DISK_NAME="endeavouros-base.qcow2"
QL_DISK_SIZE_GB="40"
QL_MEMORY_MB="6144"
QL_VCPUS="4"
QL_ENABLE_3D="1"
QL_RENDER_NODE=""

QL_ISO_NAME="EndeavourOS_Titan-Neo-2026.04.27.iso"
QL_ISO_URL="https://mirror.alpix.eu/endeavouros/iso/EndeavourOS_Titan-Neo-2026.04.27.iso"
QL_ISO_SHA512="968657495b81e5a393dd877397725b30dc274ff9f54c23c7e6d653126c796fbbafc00cd52e0b243954b52b14c888d101b55a09a7b5e2689a9247a51a8ef5ab7b"

QL_MACQUEEN_REPO="lyrka-meow/MacqueenDE"
QL_BOOT_TIMEOUT="240"
QL_STABILITY_SECONDS="30"
QL_GUEST_USER=""
